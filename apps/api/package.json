{
  "name": "@wedevs/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --project unit --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:generate": "tsx scripts/openapi.ts generate",
    "openapi:check": "tsx scripts/openapi.ts check",
    "check": "bash scripts/check.sh",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/backend": "3.26.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.8.0",
    "cloudinary": "2.11.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "file-type": "22.2.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svix": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.1",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
