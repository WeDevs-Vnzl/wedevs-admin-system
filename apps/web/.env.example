# Placeholders only. Real values are placed by the user in .env.local or in CI/Netlify settings (C5).
# Hito 1 (UI over a mock layer) needs none of these variables to run; they are used from Hito 2.

# Database (pooled connection for the app, direct connection for migrations)
DATABASE_URL="postgresql://user:password@localhost:5432/core"
DIRECT_URL="postgresql://user:password@localhost:5432/core"

# Clerk (invitation-only auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_WEBHOOK_SECRET="whsec_placeholder"

# S3-compatible object storage
STORAGE_ENDPOINT="https://storage.example.invalid"
STORAGE_BUCKET="bucket-placeholder"
STORAGE_ACCESS_KEY="access-key-placeholder"
STORAGE_SECRET_KEY="secret-key-placeholder"

# Public portal
SHARE_IP_SALT="change-me"
SHARE_UNLOCK_SECRET="change-me"

# Observability
SENTRY_DSN=""

# Public base URL (placeholder until a domain exists)
APP_URL="http://localhost:3000"

# CI-only secret (GitHub Actions): E2E_DATABASE_URL, never stored here.
